#!/usr/bin/env node
/*
 * aidlc-secrets: o cofre que o agente usa sem enxergar.
 *
 * Existe por um motivo concreto: o transcript de uma sessao Remote Control e armazenado e
 * sincronizado entre dispositivos. Um `echo $TOKEN` vira segredo persistido fora da maquina.
 * Entao nenhum verbo daqui imprime valor. `exec` injeta no ambiente do processo filho e faz
 * exec: o valor nunca passa por stdout, logo nunca vira transcript.
 *
 *   aidlc-secrets status                              # presente / ausente, nunca o valor
 *   aidlc-secrets set asc-key-id                      # prompt interativo, uma vez por maquina
 *   aidlc-secrets exec asc play -- fastlane ios listing
 *   aidlc-secrets scrub < arquivo                     # redige segredo conhecido de um texto
 *
 * Armazenamento: Keychain do macOS via `security`. Em Linux e Windows, arquivo 600 sob
 * ~/.config/aidlc/secrets/ (o mesmo contrato, sem o Keychain).
 */

import { spawnSync, spawn } from 'node:child_process'
import { existsSync, mkdirSync, readFileSync, writeFileSync, chmodSync, readdirSync, unlinkSync, statSync } from 'node:fs'
import { randomBytes } from 'node:crypto'
import { join, resolve, dirname } from 'node:path'
import { homedir, platform } from 'node:os'
import { createInterface } from 'node:readline'
import { scrub } from '../lib/scrub.mjs'
import { parseEnvFile, renderTemplate } from '../lib/env-file.mjs'

const SERVICE = 'aidlc'
const FALLBACK_DIR = join(homedir(), '.config', 'aidlc', 'secrets')
const IS_MAC = platform() === 'darwin'

/*
 * Os segredos que o projeto usa. Nome -> variavel de ambiente que o consumidor espera.
 *
 * `where` existe para o `template`: o que faz o cadastro demorar nao e digitar, e lembrar
 * em qual console cada valor mora. `isPath` marca os dois que guardam CAMINHO e
 * nao segredo, porque o import valida se o arquivo existe (um caminho errado so falha na
 * hora do upload, com mensagem de autenticacao que nao ajuda).
 */
const KNOWN = {
  'github-token': {
    env: 'GITHUB_TOKEN',
    use: 'gh CLI e API do GitHub',
    where: 'github.com/settings/tokens, token fine-grained com acesso aos repos do projeto',
  },
  'asc-key-id': {
    env: 'ASC_KEY_ID',
    use: 'fastlane App Store Connect',
    where: 'App Store Connect, Users and Access, Integrations, App Store Connect API, coluna Key ID',
  },
  'asc-issuer-id': {
    env: 'ASC_ISSUER_ID',
    use: 'fastlane App Store Connect',
    where: 'a MESMA pagina do Key ID, o Issuer ID fica no topo e vale para a conta inteira',
  },
  'asc-key-path': {
    env: 'ASC_KEY_PATH',
    use: 'caminho do .p8 (o arquivo fica fora do cofre)',
    where: 'o AuthKey_XXXXXXXX.p8 que voce baixou ao criar a chave. Caminho absoluto',
    isPath: true,
    note: 'a Apple deixa baixar uma vez so. Sem o arquivo, o caminho e criar uma chave nova.',
  },
  'play-json-key': {
    env: 'SUPPLY_JSON_KEY',
    use: 'caminho do JSON da service account do Play',
    where: 'o JSON da service account do Google Cloud, com acesso concedido em Play Console, Users and permissions',
    isPath: true,
  },
  'dockerhub-token': {
    env: 'DOCKERHUB_TOKEN',
    use: 'publish de imagem',
    where: 'hub.docker.com, Account Settings, Personal access tokens',
  },
}

/* Grupos, pra `exec asc play -- ...` puxar o conjunto certo sem listar um a um. */
const GROUPS = {
  asc: ['asc-key-id', 'asc-issuer-id', 'asc-key-path'],
  play: ['play-json-key'],
  github: ['github-token'],
  docker: ['dockerhub-token'],
}

/*
 * Segredos proprios do projeto: `.aidlc/secrets.json`, no diretorio de trabalho.
 *   { "segredos": { "nome": { "env": "VAR", "use": "...", "where": "...", "isPath": false } },
 *     "grupos": { "meu-grupo": ["nome"] } }
 * O arquivo guarda so NOMES e instrucoes. O valor nunca mora nele.
 */
try {
  const propria = JSON.parse(readFileSync(join(process.cwd(), '.aidlc', 'secrets.json'), 'utf8'))
  for (const [nome, meta] of Object.entries(propria.segredos ?? {})) {
    if (/^[a-z0-9][a-z0-9-]*$/.test(nome) && /^[A-Z][A-Z0-9_]*$/.test(meta?.env ?? '')) KNOWN[nome] = meta
  }
  for (const [g, nomes] of Object.entries(propria.grupos ?? {})) {
    if (Array.isArray(nomes) && nomes.every((n) => KNOWN[n])) GROUPS[g] = nomes
  }
} catch {
  /* sem arquivo do projeto: so os segredos de fabrica */
}

// ---------------------------------------------------------------------------

function fallbackPath(name) {
  return join(FALLBACK_DIR, `${name}.secret`)
}

function getSecret(name) {
  if (IS_MAC) {
    const r = spawnSync('security', ['find-generic-password', '-s', `${SERVICE}.${name}`, '-w'], {
      encoding: 'utf8',
      stdio: ['ignore', 'pipe', 'ignore'],
    })
    return r.status === 0 ? r.stdout.replace(/\n$/, '') : null
  }
  const p = fallbackPath(name)
  return existsSync(p) ? readFileSync(p, 'utf8').replace(/\n$/, '') : null
}

function setSecret(name, value) {
  if (IS_MAC) {
    spawnSync('security', ['delete-generic-password', '-s', `${SERVICE}.${name}`], { stdio: 'ignore' })
    const r = spawnSync(
      'security',
      ['add-generic-password', '-s', `${SERVICE}.${name}`, '-a', SERVICE, '-w', value, '-U'],
      { stdio: 'ignore' },
    )
    return r.status === 0
  }
  mkdirSync(FALLBACK_DIR, { recursive: true, mode: 0o700 })
  const p = fallbackPath(name)
  writeFileSync(p, value, { mode: 0o600 })
  chmodSync(p, 0o600)
  return true
}

function listStored() {
  if (IS_MAC) return Object.keys(KNOWN).filter((n) => getSecret(n) !== null)
  if (!existsSync(FALLBACK_DIR)) return []
  return readdirSync(FALLBACK_DIR)
    .filter((f) => f.endsWith('.secret'))
    .map((f) => f.replace(/\.secret$/, ''))
}

function resolveNames(tokens) {
  const out = []
  for (const t of tokens) {
    if (GROUPS[t]) out.push(...GROUPS[t])
    else if (KNOWN[t]) out.push(t)
    else {
      process.stderr.write(`segredo desconhecido: ${t}\nconhecidos: ${Object.keys(KNOWN).join(', ')}\ngrupos: ${Object.keys(GROUPS).join(', ')}\n`)
      process.exit(2)
    }
  }
  return [...new Set(out)]
}

// ---------------------------------------------------------------------------

const argv = process.argv.slice(2)
const cmd = argv[0]
const JSON_OUT = argv.includes('--json')

if (!cmd || cmd === 'help' || cmd === '--help') {
  process.stdout.write(
    [
      'aidlc-secrets, o cofre que o agente usa sem enxergar',
      '',
      '  status [--json]                    presente / ausente, nunca o valor',
      '  set <nome>                         prompt interativo, uma vez por maquina',
      '  template [arquivo]                 gera o arquivo em branco do que falta',
      '  import <arquivo>                   grava tudo de uma vez e destroi o arquivo',
      '  exec <nome|grupo>... -- <comando>  injeta no env do filho e faz exec',
      '  scrub                              redige segredo conhecido do stdin',
      '',
      `  conhecidos: ${Object.keys(KNOWN).join(', ')}`,
      `  grupos:     ${Object.keys(GROUPS).join(', ')}`,
      '',
      `  armazenamento: ${IS_MAC ? 'Keychain do macOS' : `${FALLBACK_DIR} (modo 600)`}`,
      '',
    ].join('\n'),
  )
  process.exit(0)
}

if (cmd === 'status') {
  const stored = new Set(listStored())
  const rows = Object.entries(KNOWN).map(([name, meta]) => ({
    name,
    env: meta.env,
    use: meta.use,
    present: stored.has(name),
  }))
  if (JSON_OUT) {
    console.log(JSON.stringify({ ok: true, backend: IS_MAC ? 'keychain' : 'file', secrets: rows }))
    process.exit(0)
  }
  const C = process.stdout.isTTY
  const g = (s) => (C ? `\x1b[32m${s}\x1b[0m` : s)
  const r = (s) => (C ? `\x1b[31m${s}\x1b[0m` : s)
  const d = (s) => (C ? `\x1b[2m${s}\x1b[0m` : s)
  console.log(`\ncofre: ${IS_MAC ? 'Keychain do macOS' : FALLBACK_DIR}\n`)
  for (const row of rows) {
    console.log(`  ${row.present ? g('presente') : r('ausente ')}  ${row.name.padEnd(20)} ${d(`${row.env} · ${row.use}`)}`)
  }
  const missing = rows.filter((x) => !x.present).length
  console.log(`\n  ${rows.length - missing} de ${rows.length} cadastrados.` + (missing ? d(`  aidlc-secrets set <nome> pra cadastrar.`) : ''))
  console.log(d('  nenhum valor e impresso, aqui nem em lugar nenhum.\n'))
  process.exit(0)
}

if (cmd === 'set') {
  const name = argv[1]
  if (!name || !KNOWN[name]) {
    process.stderr.write(`uso: aidlc-secrets set <nome>\nconhecidos: ${Object.keys(KNOWN).join(', ')}\n`)
    process.exit(2)
  }
  if (!process.stdin.isTTY) {
    // Sem TTY nao da pra esconder o eco, e um segredo digitado visivel vai pro scrollback.
    process.stderr.write('set precisa de terminal interativo (o valor nao pode ecoar).\n')
    process.exit(2)
  }
  const rl = createInterface({ input: process.stdin, output: process.stderr, terminal: true })
  process.stderr.write(`valor de ${name} (${KNOWN[name].env}): `)
  rl.question('', (answer) => {
    rl.close()
    process.stderr.write('\n')
    const v = answer.trim()
    if (!v) {
      process.stderr.write('vazio, nada gravado.\n')
      process.exit(2)
    }
    const ok = setSecret(name, v)
    process.stderr.write(ok ? `${name} gravado no cofre.\n` : `falha ao gravar ${name}.\n`)
    process.exit(ok ? 0 : 1)
  })
}

if (cmd === 'template') {
  const dest = argv[1] ?? 'aidlc.env'
  if (existsSync(dest)) {
    process.stderr.write(`${dest} ja existe. Escolha outro caminho ou apague o atual.\n`)
    process.exit(2)
  }
  const stored = new Set(listStored())
  const fields = Object.entries(KNOWN)
    // Ja cadastrado nao entra: o arquivo fica com o que falta, e so.
    .filter(([name]) => !stored.has(name))
    .map(([name, meta]) => ({ name, ...meta }))

  if (!fields.length) {
    process.stdout.write('tudo ja esta no cofre, nada a preencher.\n')
    process.exit(0)
  }

  writeFileSync(dest, renderTemplate(fields), { mode: 0o600 })
  chmodSync(dest, 0o600)
  process.stdout.write(
    [
      `${dest} criado com ${fields.length} campo(s) em branco, modo 600.`,
      '',
      'Preencha o que voce tem e rode:',
      `  aidlc-secrets import ${dest}`,
      '',
      'O import grava no cofre e destroi o arquivo. Campo em branco e pulado sem reclamar.',
      '',
    ].join('\n'),
  )
  process.exit(0)
}

if (cmd === 'import') {
  const src = argv[1]
  if (!src || !existsSync(src)) {
    process.stderr.write(`uso: aidlc-secrets import <arquivo>\nrode antes: aidlc-secrets template\n`)
    process.exit(2)
  }

  /*
   * Arquivo versionado ja vazou: esta no historico do git, e nos clones. Importar e apagar
   * daria a sensacao de resolvido sem resolver nada, entao recusamos e dizemos o que fazer.
   */
  // Roda o git no diretorio DO ARQUIVO, nao no de onde o comando foi chamado: sao
  // diferentes sempre que alguem importa um caminho de outro lugar.
  const abs = resolve(src)
  const tracked = spawnSync('git', ['ls-files', '--error-unmatch', abs], { cwd: dirname(abs), stdio: 'ignore' })
  if (tracked.status === 0) {
    process.stderr.write(
      [
        `${src} esta versionado no git, entao os valores ja estao no historico.`,
        'Importar nao desfaz isso. Rotacione os segredos expostos, tire o arquivo do',
        'versionamento, e so entao importe.',
        '',
      ].join('\n'),
    )
    process.exit(2)
  }

  const { entries, problems } = parseEnvFile(readFileSync(src, 'utf8'))
  const byEnv = Object.fromEntries(Object.entries(KNOWN).map(([name, meta]) => [meta.env, name]))

  const results = []
  for (const e of entries) {
    // Aceita tanto GITHUB_TOKEN quanto github-token: os dois aparecem na documentacao.
    const name = byEnv[e.key] ?? (KNOWN[e.key] ? e.key : null)
    if (!name) {
      results.push({ key: e.key, status: 'desconhecido' })
      continue
    }
    if (!e.value) {
      results.push({ key: e.key, name, status: 'em branco' })
      continue
    }
    if (KNOWN[name].isPath && !existsSync(e.value)) {
      // O valor e um caminho: se o arquivo nao existe, gravar seria adiar o erro.
      results.push({ key: e.key, name, status: 'caminho nao existe' })
      continue
    }
    results.push({ key: e.key, name, status: setSecret(name, e.value) ? 'gravado' : 'falhou' })
  }

  const gravados = results.filter((r) => r.status === 'gravado')
  const ruins = results.filter((r) => r.status === 'falhou' || r.status === 'caminho nao existe')

  /*
   * Destruicao: sobrescreve com bytes aleatorios do mesmo tamanho antes de apagar. Em SSD
   * com APFS isso NAO garante que o bloco original sumiu, porque a controladora escreve
   * noutro lugar. E melhor que so apagar, e nao e garantia: por isso o arquivo nunca devia
   * existir por muito tempo, que e o motivo de o import destruir sozinho.
   */
  let destruido = false
  if (!argv.includes('--keep') && !ruins.length) {
    try {
      const { size } = statSync(src)
      writeFileSync(src, randomBytes(size))
      unlinkSync(src)
      destruido = true
    } catch {
      destruido = false
    }
  }

  if (JSON_OUT) {
    console.log(JSON.stringify({ ok: !ruins.length, results, problems, destroyed: destruido }))
    process.exit(ruins.length ? 1 : 0)
  }

  console.log('')
  for (const r of results) {
    console.log(`  ${r.status.padEnd(18)} ${r.key}`)
  }
  for (const p of problems) {
    console.log(`  ${'linha ' + p.line}  ${p.why}: ${p.text}`)
  }
  console.log('')
  console.log(`  ${gravados.length} gravado(s) no cofre.`)
  if (destruido) console.log(`  ${src} sobrescrito e apagado.`)
  else if (ruins.length) console.log(`  ${src} MANTIDO por causa dos erros acima. Corrija e rode de novo.`)
  else console.log(`  ${src} mantido por --keep. Apague quando terminar.`)
  console.log('  nenhum valor foi impresso.\n')
  process.exit(ruins.length ? 1 : 0)
}

if (cmd === 'exec') {
  const sep = argv.indexOf('--')
  if (sep < 0 || sep === argv.length - 1) {
    process.stderr.write('uso: aidlc-secrets exec <nome|grupo>... -- <comando>\n')
    process.exit(2)
  }
  const names = resolveNames(argv.slice(1, sep))
  const env = { ...process.env }
  const missing = []
  for (const n of names) {
    const v = getSecret(n)
    if (v === null) missing.push(n)
    else env[KNOWN[n].env] = v
  }
  if (missing.length) {
    // Falhar aqui e melhor que deixar o comando falhar com uma mensagem de auth confusa.
    process.stderr.write(`segredo ausente: ${missing.join(', ')}\nrode: ${missing.map((m) => `aidlc-secrets set ${m}`).join(' && ')}\n`)
    process.exit(3)
  }
  const [bin, ...rest] = argv.slice(sep + 1)
  const child = spawn(bin, rest, { env, stdio: 'inherit' })
  child.on('exit', (code, signal) => process.exit(signal ? 1 : (code ?? 0)))
}

if (cmd === 'scrub') {
  let raw = ''
  process.stdin.setEncoding('utf8')
  process.stdin.on('data', (d) => (raw += d))
  process.stdin.on('end', () => {
    const { text, hits } = scrub(raw)
    process.stdout.write(text)
    if (hits.length) process.stderr.write(`${hits.length} segredo(s) redigido(s): ${[...new Set(hits)].join(', ')}\n`)
    process.exit(0)
  })
}
