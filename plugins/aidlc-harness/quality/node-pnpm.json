{
  "tech": "node-pnpm",
  "label": "Node (pnpm)",
  "status": "active",
  "repos": [
    "qualquer-projeto-node-com-pnpm-lock.yaml"
  ],
  "pkgManager": "pnpm",
  "platform": "any",
  "autonomy": "approve",
  "detect": {
    "allFiles": [
      "package.json",
      "pnpm-lock.yaml"
    ],
    "priority": 20
  },
  "gates": [
    {
      "id": "test",
      "label": "Testes",
      "cmd": "pnpm test",
      "blocking": true,
      "reject": "(^|\\s)(# fail [1-9]|[1-9]\\d* fail(ed|ing)\\b)|^FAIL\\s"
    },
    {
      "id": "lint",
      "label": "Lint",
      "cmd": "pnpm run --if-present lint",
      "blocking": false
    },
    {
      "id": "build",
      "label": "Build",
      "cmd": "pnpm run --if-present build",
      "blocking": false
    },
    {
      "id": "secscan",
      "label": "Dependencia com CVE que ja tem correcao publicada",
      "cmd": "aidlc-secscan",
      "blocking": true
    },
    {
      "id": "supply-chain",
      "label": "Dependencia nova ou trocada: existe, tem dono, nome nao e parecido com outro, esta fixada",
      "agent": "supply-chain-reviewer",
      "model": "haiku",
      "blocking": true
    }
  ],
  "security": {
    "sca": "secscan",
    "review": "supply-chain"
  },
  "strategy": {
    "always": [
      "@kit/rules/testing.md"
    ],
    "paths": [
      {
        "when": [
          "src/**",
          "lib/**"
        ],
        "read": [
          "@kit/rules/testing.md"
        ],
        "why": "codigo novo nasce com o teste ao lado, no mesmo diff"
      },
      {
        "when": [
          "package.json",
          "pnpm-lock.yaml"
        ],
        "read": [
          "@kit/rules/dependencies.md"
        ],
        "why": "dependencia nova entra com o arquivo de lock regenerado no mesmo diff e com o pacote conferido no registro antes do merge",
        "reviewer": "supply-chain-reviewer"
      }
    ]
  },
  "evidence": [
    {
      "id": "gate-output",
      "label": "Saida do gate colada no chat",
      "markers": [
        "# pass \\d+",
        "Tests?:\\s+\\d+ passed",
        "\\d+ passing",
        "Test Suites:",
        "\\d+ passed"
      ]
    },
    {
      "id": "supply-chain-review",
      "label": "Veredito do supply-chain-reviewer colado no chat",
      "markers": [
        "supply-chain-reviewer"
      ],
      "whenTouches": [
        "package.json",
        "pnpm-lock.yaml"
      ]
    }
  ],
  "ci": {
    "setup": [
      "- uses: pnpm/action-setup@v4",
      "- uses: actions/setup-node@v4\n  with:\n    node-version: '22'\n    cache: pnpm",
      "- run: pnpm install --frozen-lockfile"
    ]
  },
  "notes": "Manifesto de partida para um projeto Node que usa pnpm. Ajuste os comandos ao seu projeto copiando este arquivo para .aidlc/quality/ do repo (o do projeto substitui o do kit com o mesmo tech)."
}
