{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "$comment": "Liga o plugin aidlc-harness neste repo. O marketplace tambem precisa ser registrado uma vez por maquina (claude plugin marketplace add roqueribeiro/aidlc-harness); este bloco documenta a intencao.",
  "extraKnownMarketplaces": {
    "aidlc": { "source": { "source": "github", "repo": "roqueribeiro/aidlc-harness" } }
  },
  "enabledPlugins": { "aidlc-harness@aidlc": true },
  "permissions": {
    "allow": [
      "Bash(aidlc-gate*)",
      "Bash(aidlc-doctor*)",
      "Bash(aidlc-graph*)",
      "Bash(aidlc-harness*)",
      "Bash(aidlc-identity*)",
      "Bash(aidlc-phase*)",
      "Bash(aidlc-secrets status*)",
      "Bash(aidlc-secrets exec*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git branch*)"
    ],
    "deny": [
      "Bash(printenv)",
      "Bash(env)",
      "Bash(rm -rf /*)"
    ]
  }
}
