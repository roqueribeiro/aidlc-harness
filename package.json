{
  "name": "aidlc-harness",
  "version": "0.2.2",
  "private": true,
  "description": "Quality kit for software development with AI agents in the AI-DLC cycle.",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "aidlc-harness": "scripts/aidlc.mjs",
    "aidlc-cycle": "plugins/aidlc-harness/tools/aidlc-cycle",
    "aidlc-doctor": "plugins/aidlc-harness/tools/aidlc-doctor",
    "aidlc-gate": "plugins/aidlc-harness/tools/aidlc-gate",
    "aidlc-graph": "plugins/aidlc-harness/tools/aidlc-graph",
    "aidlc-hook": "plugins/aidlc-harness/tools/aidlc-hook",
    "aidlc-identity": "plugins/aidlc-harness/tools/aidlc-identity",
    "aidlc-init": "plugins/aidlc-harness/tools/aidlc-init",
    "aidlc-limpeza": "plugins/aidlc-harness/tools/aidlc-limpeza",
    "aidlc-lockcheck": "plugins/aidlc-harness/tools/aidlc-lockcheck",
    "aidlc-mutation": "plugins/aidlc-harness/tools/aidlc-mutation",
    "aidlc-phase": "plugins/aidlc-harness/tools/aidlc-phase",
    "aidlc-scan": "plugins/aidlc-harness/tools/aidlc-scan",
    "aidlc-secrets": "plugins/aidlc-harness/tools/aidlc-secrets",
    "aidlc-secscan": "plugins/aidlc-harness/tools/aidlc-secscan"
  },
  "files": [
    "plugins/aidlc-harness/",
    "scripts/aidlc.mjs",
    "scripts/setup.mjs",
    "scripts/lib/principal.mjs",
    ".claude-plugin/",
    "README.md",
    "README.pt-BR.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test",
    "check:plugin": "node scripts/check-plugin.mjs",
    "check:manifestos": "node scripts/check-quality-manifests.mjs",
    "check:docs": "node scripts/check-docs-consistency.mjs",
    "check:prompts": "node scripts/gerar-prompts.mjs --check",
    "check:diagramas": "node scripts/gerar-diagramas.mjs --check",
    "check:referencia": "node scripts/check-reference.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:identidade": "node plugins/aidlc-harness/tools/aidlc-identity",
    "verificar": "yarn test && yarn check:plugin && yarn check:manifestos && yarn check:docs && yarn check:prompts && yarn check:ferramentas && yarn check:diagramas && yarn check:referencia && yarn check:links && yarn check:identidade",
    "check:pacote": "node --test scripts/pacote.test.mjs",
    "check:ferramentas": "node scripts/gerar-ferramentas.mjs --check"
  }
}
